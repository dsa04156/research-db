{
  "database": "data/research.db",
  "digest_directory": "vault/Daily",
  "lookback_days": 14,
  "max_results_per_query": 20,
  "digest_max_per_topic": 20,
  "minimum_relevance_score": 2.0,
  "request_timeout_seconds": 30,
  "user_agent": "personal-research-harvester/1.0",
  "obsidian": {
    "vault_root": ".",
    "research_directory": "vault",
    "export_on_digest": true
  },
  "zotero": {
    "collection_name": "Codex Research Inbox"
  },
  "social_research": {
    "enabled": true,
    "lookback_days": 30,
    "minimum_result_relevance": 0.1,
    "excluded_platforms": ["x"],
    "platforms": [
      {
        "id": "threads",
        "access": "last30days_scrapecreators",
        "quality_tier": "E",
        "evidence_role": "lead_only",
        "note": "Keyword search of public Threads posts; coverage and result count can be limited."
      },
      {
        "id": "linkedin",
        "access": "last30days_scrapecreators_google_index",
        "quality_tier": "E",
        "evidence_role": "lead_only",
        "note": "Public Google-indexed LinkedIn posts only; not a complete LinkedIn firehose."
      },
      {
        "id": "reddit",
        "access": "last30days_public",
        "quality_tier": "D",
        "evidence_role": "lead_only"
      },
      {
        "id": "hackernews",
        "access": "last30days_public",
        "quality_tier": "D",
        "evidence_role": "lead_only"
      },
      {
        "id": "youtube",
        "access": "last30days_public",
        "quality_tier": "D",
        "evidence_role": "lead_only"
      },
      {
        "id": "tiktok",
        "access": "last30days_scrapecreators",
        "quality_tier": "E",
        "evidence_role": "lead_only",
        "note": "Public keyword results only; short-form engagement is a discovery signal, not evidence."
      },
      {
        "id": "instagram",
        "access": "last30days_scrapecreators",
        "quality_tier": "E",
        "evidence_role": "lead_only",
        "note": "Public keyword results only; coverage depends on public indexing and provider access."
      }
    ],
    "queries": [
      {
        "name": "Self-evolving agent harnesses",
        "query": "agent harness self improving context engineering",
        "platform_queries": {
          "threads": [
            "agent harness",
            "harness engineering",
            "self-improving agent"
          ]
        },
        "topic_hints": ["self-evolving-harness", "ai-agents"]
      },
      {
        "name": "Agentic Kubernetes and AI infrastructure",
        "query": "Kubernetes AI agents inference infrastructure GPU scheduling",
        "platform_queries": {
          "threads": [
            "kubernetes ai",
            "gpu scheduling"
          ]
        },
        "topic_hints": ["kubernetes", "cloud-infrastructure", "ai-agents"]
      },
      {
        "name": "Cloud-edge agent systems",
        "query": "edge AI agents distributed inference cloud edge orchestration",
        "platform_queries": {
          "threads": [
            "edge ai",
            "distributed inference"
          ]
        },
        "topic_hints": ["edge-computing", "cloud-infrastructure", "ai-agents"]
      }
    ],
    "ingest_policy": {
      "social_post_metadata": {
        "source_type": "social-post",
        "evidence_role": "lead_only"
      },
      "follow_outbound_primary_source": true,
      "canonical_url_field": "url",
      "discovery_url_field": "source_url",
      "engagement_is_ranking_signal_not_truth": true,
      "zotero_sync_lead_only": false
    }
  },
  "trend_research": {
    "enabled": true,
    "domain": "AI agents agent harness Kubernetes cloud-native AI infrastructure distributed systems edge AI",
    "daily_window_days": 1,
    "weekly_window_days": 7,
    "baseline_days": 14,
    "daily_mode": "discover_shallow",
    "excluded_sources": ["x"],
    "max_daily_candidates": 5,
    "max_weekly_candidates": 7,
    "minimum_independent_platforms": 2,
    "allow_primary_plus_community": true,
    "briefing_section": "트렌드 레이더"
  },
  "topics": [
    {
      "id": "self-evolving-harness",
